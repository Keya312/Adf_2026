{
	"name": "Df_Cleanse_Orders",
	"properties": {
		"description": "clean the order table ",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_Blob_Orders",
						"type": "DatasetReference"
					},
					"name": "AllOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ds_SQL_factOrders",
						"type": "DatasetReference"
					},
					"name": "SinkOrder"
				}
			],
			"transformations": [
				{
					"name": "ValidOrders"
				},
				{
					"name": "derivedColumn"
				},
				{
					"name": "cast1"
				},
				{
					"name": "SelectdOders"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderId as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          OrderDate as string,",
				"          Quantity as string,",
				"          UnitPrice as string,",
				"          Discount as string,",
				"          ShippingCost as string,",
				"          PaymentMethod as string,",
				"          OrderStatus as string,",
				"          Region as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['orders /year =2024/orders_*2024.csv']) ~> AllOrders",
				"cast1 filter(!isNull(Quantity) && length(trim(OrderId)) >0) ~> ValidOrders",
				"ValidOrders derive({GrossRevenue } = Quantity* UnitPrice,",
				"          DiscountAmount = Quantity*UnitPrice*ShippingCost,",
				"          NetRevenue = Quantity * UnitPrice *(1-ShippingCost),",
				"          TotalRevenue = (Quantity * UnitPrice *(1-ShippingCost)+ ShippingCost),",
				"          IsDelivered = equals(OrderStatus,'Delivered'),",
				"          OrderMonth = month(toDate(OrderDate,'yyyy-MM-dd')),",
				"          OrderYear = year(toDate(OrderDate , 'yyyy-MM-dd')),",
				"          OrderdateClean = toDate(OrderDate, 'yyyy-MM-dd')) ~> derivedColumn",
				"AllOrders cast(output(",
				"          OrderId as string,",
				"          Quantity as integer '000',",
				"          UnitPrice as integer '000',",
				"          ShippingCost as integer '000'",
				"     ),",
				"     errors: false) ~> cast1",
				"derivedColumn select(mapColumn(",
				"          OrderId,",
				"          CustomerId,",
				"          ProductId,",
				"          OrderDate,",
				"          Quantity,",
				"          UnitPrice,",
				"          DiscountPct = Discount,",
				"          ShippingCost,",
				"          PaymentMethod,",
				"          OrderStatus,",
				"          Region,",
				"          {GrossRevenue },",
				"          DiscountAmount,",
				"          NetRevenue,",
				"          TotalRevenue,",
				"          IsDelivered,",
				"          OrderMonth,",
				"          OrderYear,",
				"          OrderdateClean",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectdOders",
				"SelectdOders sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Orderid as string,",
				"          Customerid as string,",
				"          Productid as string,",
				"          Customername as string,",
				"          Productname as string,",
				"          Category as string,",
				"          Orderdate as date,",
				"          Ordermonth as integer,",
				"          Orderyear as integer,",
				"          Quantity as integer,",
				"          Unitprice as decimal(10,2),",
				"          Discountpct as decimal(10,2),",
				"          DiscountAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          Netrevenue as decimal(10,2),",
				"          CostofGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          Paymentmethod as string,",
				"          Orderstatus as string,",
				"          Isdelivered as boolean,",
				"          Region as string,",
				"          Loadat as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Orderid = OrderId,",
				"          Customerid = CustomerId,",
				"          Productid = ProductId,",
				"          Ordermonth = OrderMonth,",
				"          Orderyear = OrderYear,",
				"          Quantity,",
				"          Unitprice = UnitPrice,",
				"          DiscountAmount,",
				"          ShippingCost,",
				"          Netrevenue = NetRevenue,",
				"          Paymentmethod = PaymentMethod,",
				"          Orderstatus = OrderStatus,",
				"          Isdelivered = IsDelivered,",
				"          Region,",
				"          Orderdate = OrderdateClean",
				"     )) ~> SinkOrder"
			]
		}
	}
}