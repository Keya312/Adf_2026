{
	"name": "Df_Enrich_Orders",
	"properties": {
		"description": "Enrich Orders",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_SQL_factOrders",
						"type": "DatasetReference"
					},
					"name": "RawSource"
				},
				{
					"dataset": {
						"referenceName": "Ds_SQL_DImCustomer",
						"type": "DatasetReference"
					},
					"name": "Customers"
				},
				{
					"dataset": {
						"referenceName": "Ds_SQL_DimProducts",
						"type": "DatasetReference"
					},
					"name": "Products"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ds_SQL_factOrders",
						"type": "DatasetReference"
					},
					"name": "FinalDestination"
				}
			],
			"transformations": [
				{
					"name": "OrdersWithCustomers"
				},
				{
					"name": "OrderEnrich",
					"description": "p"
				},
				{
					"name": "WithProfit"
				},
				{
					"name": "FinalEnrich"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Orderid as string,",
				"          Customerid as string,",
				"          Productid as string,",
				"          Customername as string,",
				"          Productname as string,",
				"          Category as string,",
				"          Orderdate as date,",
				"          Ordermonth as integer,",
				"          Orderyear as integer,",
				"          Quantity as integer,",
				"          Unitprice as decimal(10,2),",
				"          Discountpct as decimal(10,2),",
				"          DiscountAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          Netrevenue as decimal(10,2),",
				"          CostofGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          Paymentmethod as string,",
				"          Orderstatus as string,",
				"          Isdelivered as boolean,",
				"          Region as string,",
				"          Loadat as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> RawSource",
				"source(output(",
				"          Customerid as string,",
				"          Fullname as string,",
				"          Email as string,",
				"          City as string,",
				"          State as string,",
				"          Country as string,",
				"          Customersegment as string,",
				"          Joindate as date,",
				"          Loadat as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Customers",
				"source(output(",
				"          Productid as string,",
				"          Productname as string,",
				"          Category as string,",
				"          SubCategory as string,",
				"          Brand as string,",
				"          Unitprice as decimal(10,2),",
				"          Costprice as decimal(10,2),",
				"          Supplier as string,",
				"          Isactive as boolean,",
				"          Loadat as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Products",
				"RawSource, Customers join(RawSource@Customerid == Customers@Customerid,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> OrdersWithCustomers",
				"OrdersWithCustomers, Products join(RawSource@Productid == Products@Productid,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> OrderEnrich",
				"OrderEnrich derive(CostofGoods = Quantity*Costprice,",
				"          GrossProfit = Netrevenue - (Quantity*Costprice),",
				"          ProfitMarginPct = (Netrevenue - Quantity*Costprice) / iif(Netrevenue == toDecimal(0), toDecimal(1), Netrevenue) * toDecimal(100)) ~> WithProfit",
				"WithProfit select(mapColumn(",
				"          Orderid,",
				"          Customerid = RawSource@Customerid,",
				"          Productid = RawSource@Productid,",
				"          Customername,",
				"          Productname = RawSource@Productname,",
				"          Category = RawSource@Category,",
				"          Orderdate,",
				"          Ordermonth,",
				"          Orderyear,",
				"          Quantity,",
				"          Unitprice = RawSource@Unitprice,",
				"          Discountpct,",
				"          DiscountAmount,",
				"          GrossRevenue,",
				"          ShippingCost,",
				"          Netrevenue,",
				"          CostofGoods,",
				"          GrossProfit,",
				"          Paymentmethod,",
				"          Orderstatus,",
				"          Isdelivered,",
				"          Region,",
				"          Fullname,",
				"          Email,",
				"          City,",
				"          State,",
				"          Country,",
				"          Customersegment,",
				"          Joindate,",
				"          Productid = Products@Productid,",
				"          Productname = Products@Productname,",
				"          Category = Products@Category,",
				"          SubCategory,",
				"          Brand,",
				"          Unitprice = Products@Unitprice,",
				"          Costprice,",
				"          Supplier,",
				"          Isactive,",
				"          ProfitMarginPct",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> FinalEnrich",
				"FinalEnrich sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Orderid as string,",
				"          Customerid as string,",
				"          Productid as string,",
				"          Customername as string,",
				"          Productname as string,",
				"          Category as string,",
				"          Orderdate as date,",
				"          Ordermonth as integer,",
				"          Orderyear as integer,",
				"          Quantity as integer,",
				"          Unitprice as decimal(10,2),",
				"          Discountpct as decimal(10,2),",
				"          DiscountAmount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          Netrevenue as decimal(10,2),",
				"          CostofGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          Paymentmethod as string,",
				"          Orderstatus as string,",
				"          Isdelivered as boolean,",
				"          Region as string,",
				"          Loadat as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Orderid,",
				"          Customerid,",
				"          Productid,",
				"          Customername = Fullname,",
				"          Productname,",
				"          Category,",
				"          Orderdate,",
				"          Ordermonth,",
				"          Orderyear,",
				"          Quantity,",
				"          Unitprice,",
				"          DiscountAmount = Discountpct,",
				"          DiscountAmount,",
				"          GrossRevenue,",
				"          ShippingCost,",
				"          Netrevenue,",
				"          CostofGoods,",
				"          GrossProfit,",
				"          Paymentmethod,",
				"          Orderstatus,",
				"          Isdelivered,",
				"          Region",
				"     )) ~> FinalDestination"
			]
		}
	}
}